{
  "name": "ur-platform",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md}\"",
    "clean": "find . -type d \\( -name node_modules -o -name dist -o -name .turbo \\) -prune -exec rm -rf {} +"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "6.0.3"
  }
}
